# ==============================================================================
# ORQIVA TECH BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/orqiva_admin?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret (Generate a strong 64-char random string for production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Allowed Frontend URLs for CORS
FRONTEND_URL=https://admin.orqivatech.com
ADMIN_FRONTEND_URL=https://admin.orqivatech.com
PUBLIC_WEBSITE_URL=https://www.orqivatech.com
CORS_ALLOWED_ORIGINS=https://admin.orqivatech.com,https://www.orqivatech.com

# Initial Super Admin Seed Credentials (used only during initial seed)
ADMIN_NAME=ORQIVA Administrator
ADMIN_EMAIL=admin@orqivatech.com
ADMIN_PASSWORD=

# Cloudinary (Optional, for cloud media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP Email Service (for lead and meeting notifications)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Calendar / Meet Integration (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

